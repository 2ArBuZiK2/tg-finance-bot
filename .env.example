# Токен бота от @BotFather
BOT_TOKEN=

# Необязательно: путь к базе данных.
# По умолчанию используется db.sqlite3 в корне проекта.
# DATABASE_URL=sqlite+aiosqlite:///db.sqlite3

# Необязательно: часовой пояс в формате IANA.
# Влияет на «сегодня», «этот месяц» и даты новых операций.
# Если не задан, используется время сервера.
# TIMEZONE=Europe/Moscow
